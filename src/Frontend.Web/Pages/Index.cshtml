@page
@model Frontend.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Storefront";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="display-5">Storefront PoC</h1>
        <p class="lead">Browse the seeded catalog and add products to your session-backed cart.</p>
    </div>
    <a class="btn btn-outline-primary" asp-page="/Cart">View cart</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.BannerMessage))
{
    <div class="alert alert-success">@Model.BannerMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="get" class="row g-2 mb-4">
    <div class="col-auto">
        <select class="form-select" asp-for="Category">
            <option value="">All categories</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category">@category</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-secondary" type="submit">Filter</button>
    </div>
</form>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var product in Model.Products)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img class="card-img-top" src="/images/@(product.Category.ToLowerInvariant()).svg" alt="@product.Category placeholder" />
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between gap-2">
                        <h2 class="h5 card-title">@product.Name</h2>
                        <span class="badge text-bg-info align-self-start">@product.Category</span>
                    </div>
                    <p class="card-text small text-muted">@product.Description</p>
                    <p class="fw-bold fs-5 mt-auto">@product.UnitPrice.ToString("C") MXN</p>
                    <span class="badge @(product.StockQuantity <= 2 ? "text-bg-warning" : "text-bg-success") mb-3">@product.StockQuantity in stock</span>
                    <form method="post" asp-page-handler="Add" class="d-flex gap-2">
                        <input type="hidden" name="productId" value="@product.Id" />
                        <input type="hidden" name="category" value="@Model.Category" />
                        <input class="form-control" type="number" min="1" name="quantity" value="1" aria-label="Quantity for @product.Name" />
                        <button class="btn btn-primary" type="submit">Add to cart</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
